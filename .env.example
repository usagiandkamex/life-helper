# Copy to .env for local development. Never commit .env (it is git-ignored).
# In Azure these values are ACA secrets / environment variables set by azd (see docs/setup.md).

LH_ENVIRONMENT=development
LH_BASE_URL=http://localhost:8000
# LH_DATA_DIR=./.data            # default /data (the Azure Files mount)
# LH_STATIC_DIR=app/frontend/dist

# Local sign-in without an OAuth App: LH_DEV_GITHUB_TOKEN=$(gh auth token --user usagiandkamex)
LH_DEV_GITHUB_TOKEN=

# GitHub OAuth App (local development app with callback http://localhost:8000/auth/callback)
LH_GITHUB_OAUTH_CLIENT_ID=
LH_GITHUB_OAUTH_CLIENT_SECRET=

# Generated automatically in development if empty. Required in production.
LH_SESSION_SECRET=
LH_TOKEN_ENCRYPTION_KEY=

# Connectors (free services). Leave empty to disable. Stock prices (Yahoo Finance) need no key.
LH_RAKUTEN_APPLICATION_ID=
LH_RAKUTEN_ACCESS_KEY=

# Headless Chromium tools (browser_*). Needs `uv run playwright install --only-shell chromium` locally.
# LH_BROWSER_ENABLED=true

# GitHub App for issue notifications (optional)
LH_GITHUB_APP_ID=
LH_GITHUB_APP_PRIVATE_KEY=
LH_GITHUB_APP_INSTALLATION_ID=
LH_NOTIFY_REPO=usagiandkamex/life-helper-notifications
